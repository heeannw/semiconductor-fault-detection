# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (raw SECOM data should not be committed — download via README instructions)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# WM-811K derived (32x32, defect-labeled only, 3MB) — kept so notebook 06 runs without
# needing the 2GB raw pickle + legacy pandas venv conversion step
!data/processed/wafer_map_defects.npz

# Model artifacts (reproducible by re-running notebooks/03_modeling.ipynb)
models/*
!models/.gitkeep
!models/model_comparison.csv
!models/feature_selection_grid.csv
!models/feature_selection_comparison.csv
!models/lstm_autoencoder_results.csv
!models/wafer_map_cnn_report.csv

# One-off legacy conversion venv (see scripts/convert_wm811k.py)
.venv_legacy/

# pytest
.pytest_cache/

# Papers (large PDFs — keep out of git history)
docs/papers/*.pdf

# Node / React
node_modules/
frontend/build/
frontend/dist/

# Env files
.env
.env.local

# DB
*.sqlite3
*.db

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
